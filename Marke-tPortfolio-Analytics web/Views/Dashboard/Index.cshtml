@model Marke_tPortfolio_Analytics_web.ViewModels.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = "Accueil";
}

@* Écran d'onboarding si l'user n'a pas encore de portefeuille *@
@if (!Model.HasPortfolios)
{ 
    @* contenu onboarding *@
    <div class="page-header">
        <div>
            <div class="page-title">Bonjour, @Model.UserName </div>
            <div class="page-sub">Bienvenue sur Catalis — commençons.</div>
        </div>
    </div>
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;
                    min-height:400px;text-align:center;gap:24px">
        <div style="width:80px;height:80px;background:var(--green-faint);
                        border:1px solid rgba(0,208,132,.2);border-radius:50%;
                        display:flex;align-items:center;justify-content:center;font-size:32px">
            📊
        </div>
        <div>
            <div style="font-family:'Sora',sans-serif;font-size:22px;font-weight:700;margin-bottom:8px">
                Aucun portefeuille pour l'instant
            </div>
            <div style="color:var(--t4);font-size:14px;max-width:400px">
                Créez votre premier portefeuille et ajoutez des positions pour voir vos analyses.
            </div>
        </div>
        <a href="/Portfolios/Create" class="btn btn-green btn-lg">
            + Créer mon premier portefeuille →
        </a>
    </div>
    return;
}

<div class="page-header">
    <div>
        <div class="page-title">Bonjour, @Model.UserName </div>
        <div class="page-sub">@Model.NbPortfolios portefeuille(s) · Mis à jour maintenant</div>
    </div>
    <div class="header-actions">
        <a href="/Portfolios/Create" class="btn btn-ghost">+ Portefeuille</a>
        <a href="/Analytics" class="btn btn-green">Analyser →</a>
    </div>
</div>

@* Page principale — rendue uniquement si l'user a au moins un portefeuille *@

@* Score Investisseur — bandeau en haut avec la jauge SVG *@
<div class="score-banner">
    <div class="score-ring">
        <svg viewBox="0 0 80 80">
            @* Cercle de fond gris — toujours plein *@
            <circle cx="40" cy="40" r="34" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="7" />

            @* Cercle de progression coloré
               stroke-dasharray="213.6" -> circonférence totale du cercle (2πr)
               stroke-dashoffset -> portion non colorée
               ScoreOffset = 0 -> cercle plein (100/100)
               ScoreOffset = 213.6 -> cercle vide (0/100) *@
            <circle cx="40" cy="40" r="34" fill="none" stroke="@Model.ScoreCouleur" stroke-width="7"
                    stroke-dasharray="213.6"
                    stroke-dashoffset="@Model.ScoreOffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                    stroke-linecap="round" />
        </svg>
        @* Score affiché au centre de la jauge *@
        <div class="score-ring-num">
            <strong style="color:@Model.ScoreCouleur">@Model.ScoreInvestisseur</strong>
            <span>/100</span>
        </div>
    </div>
    <div class="score-info">
        <h3>Score Investisseur · @Model.ScoreNiveau</h3>
        <p>@Model.ScoreMessage</p>
        @* Pills — badges de détail du score (max 4 affichés) *@
        <div class="score-pills">
            @foreach (var pill in Model.ScorePills)
            {
                <span class="pill @(
                    pill.Contains("Efficient") ||
                    pill.Contains("Diversifié") ||
                    pill.Contains("Multi-actifs") ||
                    pill.Contains("Exposition obligataire") ||
                    pill.Contains("Au-dessus")
                        ? "pill-green"
                    : pill.Contains("Sous-optimal") ||
                      pill.Contains("Concentré") ||
                      pill.Contains("Mono-actif") ||
                      pill.Contains("Sans obligataire")
                        ? "pill-red" 
                    : "pill-amber")">
                    @pill
                </span>
            }
        </div>
    </div>
</div>

@* KPIs — 4 métriques clés en ligne *@
<div class="kpi-grid">
    @* KPI Valeur totale *@
    <div class="kpi" style="--accent:var(--green)">
        <div class="kpi-label">Valeur totale</div>
        <div class="kpi-val green">€@Model.ValeurTotaleEur.ToString("N0")</div>
         @* RendementTotal -> couleur selon signe *@
        <div class="kpi-delta @(Model.RendementTotal >= 0 ? "up" : "dn")">
            @(Model.RendementTotal >= 0 ? "▲" : "▼") @Math.Abs(Model.RendementTotal).ToString("F1")% depuis achat
        </div>
        @* Valeur en USD + taux pour référence *@
        <div class="kpi-sub">$@Model.ValeurTotaleUsd.ToString("N0") · taux @Model.TauxEurUsd.ToString("F3")</div>
    </div>

     @* KPI Rendement total *@
    <div class="kpi" style="--accent:var(--blue)">
        <div class="kpi-label">Rendement total</div>
        <div class="kpi-val @(Model.RendementTotal >= 0 ? "green" : "red")">
            @(Model.RendementTotal >= 0 ? "+" : "")@Model.RendementTotal.ToString("F1")%
        </div>
        <div class="kpi-delta" style="color:var(--t4)">Depuis votre premier achat</div>
        <div class="kpi-sub">@Model.NbPortfolios portefeuille(s) · @Model.Positions.Count position(s)</div>
    </div>

    @* KPI Sharpe Ratio — affiché seulement si on a assez d'historique *@
    <div class="kpi" style="--accent:var(--amber)">
        <div class="kpi-label">Sharpe Ratio</div>
        @if (Model.HasMetriquesAnalytiques)
        {
            @* Couleur selon le niveau du Sharpe *@
            <div class="kpi-val @(Model.SharpeRatio > 1 ? "green" : Model.SharpeRatio > 0 ? "amber" : "red")">
                @Model.SharpeRatio.ToString("F2")
            </div>
            <div class="kpi-delta" style="color:var(--t4)">
                @(Model.SharpeRatio > 2 ? "Excellent" : Model.SharpeRatio > 1 ? "Bon" :
                            Model.SharpeRatio > 0 ? "Insuffisant" : "Danger")
        </div>
        <div class="kpi-sub">Seuil excellent : > 2</div>
                }
        else
        {
            @* Pas assez d'historique -> on affiche "—" plutôt que 0 *@
            <div class="kpi-val" style="color:var(--t4)">—</div>
            <div class="kpi-sub">Historique insuffisant (moins d'1 an)</div>
        }
    </div>

    @* KPI Score investisseur *@
    <div class="kpi" style="--accent:var(--purple)">
        <div class="kpi-label">Score</div>
        <div class="kpi-val" style="color:@Model.ScoreCouleur">
            @Model.ScoreInvestisseur<span style="font-size:14px;font-weight:400">/100</span>
        </div>
        <div class="kpi-delta" style="color:var(--t4)">@Model.ScoreNiveau</div>
        <div class="kpi-sub">Basé sur 6 critères</div>
    </div>
</div>

@* Graphique donut d'allocation + tableau résumé *@
<div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:24px">
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Allocation du portefeuille</div>
                <div class="card-sub">Répartition par valeur actuelle</div>
            </div>
        </div>
        @if (Model.Allocation.Any())
        {
            <div style="display:flex;align-items:center;gap:24px">
                @* SVG donut construit manuellement avec des cercles SVG *@
                <svg viewBox="0 0 110 110" style="width:110px;height:110px;flex-shrink:0">
                    @{
                         @* circonférence du cercle SVG du donut *@
                        double cumul = 0; double circ = 251.2;
                    }
                     @* Cercle de fond gris *@
                    <circle cx="55" cy="55" r="40" fill="none" stroke="var(--dark-4)" stroke-width="18" />

                    @* Un arc par actif dans l'allocation *@
                    @foreach (var item in Model.Allocation)
                    {

                        @* Rotation -> positionne l'arc après le précédent *@
                        double rot = -90 + (cumul / 100 * 360);
                        <circle cx="55" cy="55" r="40" fill="none" stroke="@item.Couleur" stroke-width="18"
                                stroke-dasharray="@circ"
                                stroke-dashoffset="@(circ - circ * (double)item.Poids / 100)"
                                transform="rotate(@rot.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) 55 55)" />
                        cumul += (double)item.Poids;
                    }

                    @* Texte au centre du donut *@
                    <text x="55" y="51" text-anchor="middle" fill="white" font-family="Sora" font-size="13" font-weight="800">@Model.Positions.Count</text>
                    <text x="55" y="63" text-anchor="middle" fill="#475569" font-family="DM Sans" font-size="8">actifs</text>
                </svg>

                @* Légende du donut *@
                <div style="flex:1;display:flex;flex-direction:column;gap:8px">
                    @foreach (var item in Model.Allocation)
                    {
                        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--t3)">
                            @* Pastille colorée *@
                            <div style="width:8px;height:8px;border-radius:50%;background:@item.Couleur;flex-shrink:0"></div>
                            @item.Ticker
                            <span style="margin-left:auto;font-weight:600;color:var(--t1)">@item.Poids.ToString("F1")%</span>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div style="color:var(--t4);font-size:13px;text-align:center;padding:24px">Aucune position</div>
        }
    </div>

    <div class="card">
        <div class="card-header"><div class="card-title">Résumé</div></div>
        <div style="display:flex;flex-direction:column;gap:0">
            @foreach (var (label, val, color) in new[]
                        {
                        ("Portefeuilles", Model.NbPortfolios.ToString(),                    ""),
                        ("Positions",     Model.Positions.Count.ToString(),                 ""),
                        ("Valeur EUR",    "€" + Model.ValeurTotaleEur.ToString("N2"),       "var(--green)"),
                        ("Valeur USD",    "$" + Model.ValeurTotaleUsd.ToString("N2"),       ""),
                        ("Taux EUR/USD",  Model.TauxEurUsd.ToString("F4"),                  ""),
                        })
            {
                <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border-2)">
                    <span style="font-size:13px;color:var(--t4)">@label</span>
                    <span style="font-weight:700;@(string.IsNullOrEmpty(color) ? "" : $"color:{color}")">@val</span>
                </div>
            }
        </div>
        <a href="/Analytics" class="btn btn-green btn-full" style="margin-top:16px;height:40px;font-size:13px">
            Analyse complète →
        </a>
    </div>
</div>

@* Tableau de toutes les positions triées par valeur décroissante *@
@if (Model.Positions.Any())
{
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Toutes les positions</div>
                <div class="card-sub">@Model.Positions.Count actif(s) · Tri par valeur</div>
            </div>
            <a href="/Portfolios" class="btn btn-ghost btn-sm">Gérer</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Actif</th>
                        <th>Quantité</th>
                        <th>Prix achat moy.</th>
                        <th>Prix actuel</th>
                        <th>Valeur EUR</th>
                        <th>P&amp;L</th>
                        <th>Poids</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pos in Model.Positions.OrderByDescending(p => p.ValeurEur))
                    {
                        <tr>
                            <td>
                                <div class="td-ticker">@pos.Ticker</div>
                                <div class="td-name">@pos.Nom</div>
                            </td>
                            <td>@pos.Quantite.ToString("G")</td>
                            <td>@pos.Devise @pos.AvgBuyPrice.ToString("N2")</td>
                            <td>@pos.Devise @pos.PrixActuel.ToString("N2")</td>
                            <td style="font-weight:600">€@pos.ValeurEur.ToString("N2")</td>
                            <td class="@(pos.PnlPct >= 0 ? "td-up" : "td-dn")">
                                @(pos.PnlPct >= 0 ? "+" : "")@pos.PnlPct.ToString("F2")%
                            </td>
                            <td>

                                @* Barre de progression proportionnelle au poids *@
                                <div style="display:flex;align-items:center;gap:8px">
                                    <div class="metric-bar-wrap" style="width:60px">
                                        <div class="metric-bar" style="width:@pos.Poids.ToString("F0")%;background:var(--green)"></div>
                                    </div>
                                    <span style="font-size:11px;color:var(--t4)">@pos.Poids.ToString("F1")%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
