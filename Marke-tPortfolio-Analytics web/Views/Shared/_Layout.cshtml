<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — Catalis" : "Catalis")</title>

    <!-- Fonts Catalis -->
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <!-- CSS Catalis -->
    <link rel="stylesheet" href="~/css/mpa.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="mpa-body">

    <div class="mpa-layout">
        @await Html.PartialAsync("_Sidebar")

        <div class="mpa-main">
            @await Html.PartialAsync("_Topbar")
            @await Html.PartialAsync("_AlertMessages")

            <main class="mpa-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
