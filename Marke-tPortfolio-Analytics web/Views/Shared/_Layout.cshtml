<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — MPA" : "MarketPortfolioAnalytics")</title>

    <!-- Google Fonts : Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <!-- MPA CSS principal -->
    <link rel="stylesheet" href="~/css/mpa.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="mpa-body">

    <!-- ═══ LAYOUT : SIDEBAR + MAIN ═══════════════════════════════════════ -->
    <div class="mpa-layout">

        <!-- Sidebar -->
        @await Html.PartialAsync("_Sidebar")

        <!-- Zone principale -->
        <div class="mpa-main">

            <!-- Topbar -->
            @await Html.PartialAsync("_Topbar")

            <!-- Messages flash (succès / erreur / warning) -->
            @await Html.PartialAsync("_AlertMessages")

            <!-- Contenu de la page -->
            <main class="mpa-content">
                @RenderBody()
            </main>

        </div><!-- /mpa-main -->
    </div><!-- /mpa-layout -->
    <!-- ═══ SCRIPTS ════════════════════════════════════════════════════════ -->
    <!-- jQuery (nécessaire pour les appels AJAX analytics) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- JS MPA -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>

