@model Marke_tPortfolio_Analytics_web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Erreur — Catalis</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@700;800&family=DM+Sans:wght@400;500&display=swap"
          rel="stylesheet" />
    <style>
        body {
            background: #050810;
            color: #e2e8f0;
            font-family: 'DM Sans',sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        .wrap {
            text-align: center;
            max-width: 480px;
            padding: 40px
        }

        .code {
            font-family: 'Sora',sans-serif;
            font-size: 80px;
            font-weight: 800;
            color: rgba(255,255,255,.08);
            line-height: 1;
            margin-bottom: 16px
        }

        h1 {
            font-family: 'Sora',sans-serif;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 8px
        }

        p {
            color: #475569;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 24px
        }

        .req {
            background: #111827;
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 12px;
            color: #475569;
            margin-bottom: 24px
        }

        a {
            display: inline-block;
            background: #00d084;
            color: #050810;
            padding: 10px 24px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px
        }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="code">500</div>
        <h1>Une erreur est survenue</h1>
        <p>Quelque chose s'est mal passé. Revenez au tableau de bord ou contactez le support.</p>
        @if (Model.ShowRequestId)
        {
            <div class="req">Request ID : @Model.RequestId</div>
        }
        <a href="/Dashboard">← Retour au dashboard</a>
    </div>
</body>
</html>
