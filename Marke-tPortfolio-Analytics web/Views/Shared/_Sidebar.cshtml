@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
}
<aside class="mpa-sidebar" id="sidebar">

    <div class="sb-logo">
        <div class="sb-logo-icon"></div>
        <span class="sb-logo-name">Catalis</span>
    </div>

    <nav class="sb-nav">
        <a class="sb-item @(ctrl == "Dashboard" ? "active" : "")" href="/Dashboard">
            <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
            </svg>Dashboard
        </a>
        <a class="sb-item @(ctrl == "Portfolios" ? "active" : "")" href="/Portfolios">
            <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            </svg>Portefeuilles
        </a>
        <a class="sb-item @(ctrl == "Assets" ? "active" : "")" href="/Assets">
            <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23" />
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>Marché
        </a>
        <a class="sb-item @(ctrl == "Analytics" ? "active" : "")" href="/Analytics">
            <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>Analytics
        </a>
        <div class="sb-divider"></div>
        <a class="sb-item @(ctrl == "Goal" ? "active" : "")" href="/Goal">
            <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <circle cx="12" cy="12" r="6" />
                <circle cx="12" cy="12" r="2" />
            </svg>Mon Objectif
        </a>
        <a class="sb-item @(ctrl == "Profile" ? "active" : "")" href="/Profile">
            <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>Profil
        </a>
    </nav>

    <div class="sb-footer">
        <div class="sb-user-chip">
            <div class="sb-avatar">
                @(Context.Session.GetString("UserName")?.Substring(0, 1).ToUpper() ?? "?")
            </div>
            <div style="min-width:0">
                <div class="sb-user-name">@Context.Session.GetString("UserName")</div>
                <div class="sb-user-email">@Context.Session.GetString("UserEmail")</div>
            </div>
        </div>
        <a class="sb-item sb-logout" href="/Auth/Logout" style="margin-top:6px">
            <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>Déconnexion
        </a>
    </div>
</aside>
<div class="sb-overlay" id="sbOverlay" onclick="document.getElementById('sidebar').classList.remove('open');this.classList.remove('open')"></div>
