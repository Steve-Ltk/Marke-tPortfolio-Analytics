@model Marke_tPortfolio_Analytics_web.ViewModels.RegisterViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Inscription — Catalis";
}

<div class="mpa-auth-body">

    <!-- ── Panneau gauche ─────────────────────────────────── -->
    <div class="auth-left">
        <div>
            <div class="auth-logo">
                <div class="auth-logo-icon"></div>
                <span class="auth-logo-name">Catalis</span>
            </div>
        </div>

        <div>
            <div class="auth-eyebrow">
                <div class="auth-eyebrow-dot"></div>
                Rejoindre Catalis — Gratuit
            </div>

            <h1 class="auth-headline">
                Votre avenir
                <span class="auth-accent">financier<br>commence ici.</span>
                <span class="auth-light">Maintenant.</span>
            </h1>
            <p class="auth-subline">Aucune carte bancaire requise.</p>

            <p class="auth-body-copy">
                Créez votre compte en 30 secondes et accédez immédiatement à
                <strong>tous les outils quantitatifs</strong> de Catalis — sans limitation.
            </p>

            <div class="auth-features">
                <div class="auth-feat">
                    <div class="auth-feat-icon">⚡</div>
                    <div class="auth-feat-text">
                        <strong>Onboarding en 30 secondes</strong>
                        <span>Wizard guidé pour construire votre premier portefeuille</span>
                    </div>
                </div>
                <div class="auth-feat">
                    <div class="auth-feat-icon">🛡️</div>
                    <div class="auth-feat-text">
                        <strong>Données sécurisées</strong>
                        <span>Chiffrement ASP.NET Identity · Aucune donnée bancaire</span>
                    </div>
                </div>
                <div class="auth-feat">
                    <div class="auth-feat-icon">📈</div>
                    <div class="auth-feat-text">
                        <strong>Prix temps réel via FMP</strong>
                        <span>NYSE, NASDAQ, Euronext · Taux EUR/USD auto</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-stats">
            <div class="auth-stat">
                <div class="auth-stat-num green">∞</div>
                <div class="auth-stat-label">Portefeuilles</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num">100%</div>
                <div class="auth-stat-label">Gratuit</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num">FMP</div>
                <div class="auth-stat-label">Temps réel</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num green">30s</div>
                <div class="auth-stat-label">Inscription</div>
            </div>
        </div>

        <!-- Ticker tape -->
        <div class="auth-ticker">
            <div class="ticker-track">
                <span class="tick-item"><span class="tick-sym">AAPL</span><span class="tick-up">▲ 1.24%</span></span>
                <span class="tick-item"><span class="tick-sym">MSFT</span><span class="tick-up">▲ 0.87%</span></span>
                <span class="tick-item"><span class="tick-sym">NVDA</span><span class="tick-up">▲ 3.41%</span></span>
                <span class="tick-item"><span class="tick-sym">OR.PA</span><span class="tick-dn">▼ 0.32%</span></span>
                <span class="tick-item"><span class="tick-sym">TTE.PA</span><span class="tick-up">▲ 0.55%</span></span>
                <span class="tick-item"><span class="tick-sym">S&P 500</span><span class="tick-up">▲ 0.43%</span></span>
                <span class="tick-item"><span class="tick-sym">CAC 40</span><span class="tick-dn">▼ 0.18%</span></span>
                <span class="tick-item"><span class="tick-sym">AMZN</span><span class="tick-up">▲ 1.09%</span></span>
                <span class="tick-item"><span class="tick-sym">AAPL</span><span class="tick-up">▲ 1.24%</span></span>
                <span class="tick-item"><span class="tick-sym">MSFT</span><span class="tick-up">▲ 0.87%</span></span>
                <span class="tick-item"><span class="tick-sym">NVDA</span><span class="tick-up">▲ 3.41%</span></span>
                <span class="tick-item"><span class="tick-sym">OR.PA</span><span class="tick-dn">▼ 0.32%</span></span>
                <span class="tick-item"><span class="tick-sym">TTE.PA</span><span class="tick-up">▲ 0.55%</span></span>
                <span class="tick-item"><span class="tick-sym">S&P 500</span><span class="tick-up">▲ 0.43%</span></span>
                <span class="tick-item"><span class="tick-sym">CAC 40</span><span class="tick-dn">▼ 0.18%</span></span>
            </div>
        </div>
    </div>

    <!-- ── Panneau droit ──────────────────────────────────── -->
    <div class="auth-right">
        <div class="auth-form-wrap">

            <!-- Tabs -->
            <div class="auth-tabs">
                <a href="/Auth/Login" class="auth-tab">Connexion</a>
                <a href="/Auth/Register" class="auth-tab active">Inscription</a>
            </div>

            <h2 class="auth-form-title">Créer un compte</h2>
            <p class="auth-form-sub">Rejoignez Catalis. C'est gratuit, pour toujours.</p>

            <!-- Alerts -->
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="mpa-alert mpa-alert-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    @ViewBag.Error
                    <button class="alert-close" onclick="this.closest('.mpa-alert').remove()">✕</button>
                </div>
            }

            <form asp-action="Register" asp-controller="Auth" method="post" id="registerForm">
                @Html.AntiForgeryToken()

                <!-- Nom d'utilisateur -->
                <div class="field">
                    <label asp-for="FullName">Nom d'utilisateur</label>
                    <div style="position:relative">
                        <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);opacity:.4;pointer-events:none"
                             width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <input asp-for="FullName"
                               class="form-control @(ViewData.ModelState["UserName"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               placeholder="jean_dupont" style="padding-left:42px"
                               autocomplete="username" />
                    </div>
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <!-- Email -->
                <div class="field">
                    <label asp-for="Email">Adresse e-mail</label>
                    <div style="position:relative">
                        <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);opacity:.4;pointer-events:none"
                             width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                        </svg>
                        <input asp-for="Email"
                               class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               type="email" placeholder="jean.dupont@email.com"
                               style="padding-left:42px" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <!-- Mot de passe -->
                <div class="field">
                    <label asp-for="Password">Mot de passe</label>
                    <div style="position:relative">
                        <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);opacity:.4;pointer-events:none"
                             width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <input asp-for="Password" id="passwordInput"
                               class="form-control @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               type="password" placeholder="Min. 8 caractères"
                               style="padding-left:42px;padding-right:46px"
                               autocomplete="new-password"
                               oninput="checkStrength(this.value)" />
                        <button type="button" id="togglePwd"
                                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#475569;padding:4px;transition:color .15s">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <div class="strength-bars">
                        <div class="s-bar" id="sb1"></div>
                        <div class="s-bar" id="sb2"></div>
                        <div class="s-bar" id="sb3"></div>
                        <div class="s-bar" id="sb4"></div>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <!-- Confirmer -->
                <div class="field">
                    <label asp-for="ConfirmPassword">Confirmer le mot de passe</label>
                    <div style="position:relative">
                        <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);opacity:.4;pointer-events:none"
                             width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                            <polyline points="20,6 9,17 4,12" />
                        </svg>
                        <input asp-for="ConfirmPassword"
                               class="form-control @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               type="password" placeholder="Répétez le mot de passe"
                               style="padding-left:42px" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn-auth-submit" id="submitBtn">
                    <span id="submitText">Créer mon compte</span>
                    <span class="btn-auth-arrow">→</span>
                    <svg id="submitSpinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:none;animation:spin .7s linear infinite">
                        <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                    </svg>
                </button>

                <p class="auth-switch">
                    Déjà un compte ? <a href="/Auth/Login">Se connecter →</a>
                </p>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Toggle password
        document.getElementById('togglePwd').addEventListener('click', function () {
          const input = document.getElementById('passwordInput');
          input.type = input.type === 'password' ? 'text' : 'password';
        });

        // Password strength
        function checkStrength(val) {
          const bars = [1,2,3,4].map(n => document.getElementById('sb' + n));
          const checks = [
            val.length >= 8,
            /[A-Z]/.test(val),
            /[0-9]/.test(val),
            /[^A-Za-z0-9]/.test(val)
          ];
          const score = checks.filter(Boolean).length;
          const colors = { 1: '#f43f5e', 2: '#f59e0b', 3: '#00d084', 4: '#00d084' };
          bars.forEach((b, i) => {
            b.style.background = i < score ? (colors[score] || '#00d084') : 'rgba(255,255,255,.07)';
          });
        }

        // Submit spinner
        document.getElementById('registerForm').addEventListener('submit', function () {
          const btn = document.getElementById('submitBtn');
          document.getElementById('submitText').textContent = 'Création du compte…';
          document.getElementById('submitSpinner').style.display = 'inline';
          document.querySelector('.btn-auth-arrow').style.display = 'none';
          btn.disabled = true;
        });
    </script>
}
