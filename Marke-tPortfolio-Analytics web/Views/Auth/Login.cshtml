@model Marke_tPortfolio_Analytics_web.ViewModels.LoginViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Connexion";
}

<div class="auth-layout">

    <!-- ══ GAUCHE — BRANDING ════════════════════════════════════════════ -->
    <div class="auth-left">

        <div class="auth-logo">
            <div class="auth-logo-icon"></div>
            <span class="auth-logo-name">MPA</span>
        </div>

        <div>
            <h1 class="auth-headline">Analysez.<br>Optimisez.<br>Investissez.</h1>
            <p class="auth-tagline">
                MarketPortfolioAnalytics vous donne accès aux mêmes outils
                que les gestionnaires professionnels — Monte Carlo, Markowitz,
                backtesting — sans intermédiaire.
            </p>
        </div>

        <div class="auth-features">
            <div class="auth-feat">
                <div class="auth-feat-icon" style="background:rgba(59,130,246,.15)">📈</div>
                <div class="auth-feat-text">Simulation Monte Carlo sur vos portefeuilles réels</div>
            </div>
            <div class="auth-feat">
                <div class="auth-feat-icon" style="background:rgba(16,185,129,.15)">⚡</div>
                <div class="auth-feat-text">Optimisation Markowitz — poids optimaux en un clic</div>
            </div>
            <div class="auth-feat">
                <div class="auth-feat-icon" style="background:rgba(245,158,11,.15)">🎯</div>
                <div class="auth-feat-text">Wizard « Mon Objectif » — simulez votre avenir financier</div>
            </div>
        </div>

        <div class="auth-stats">
            <div class="auth-stat">
                <div class="auth-stat-num">210</div>
                <div class="auth-stat-label">Tests API validés</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num">4</div>
                <div class="auth-stat-label">Modules analytics</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num">EUR</div>
                <div class="auth-stat-label">Conversion temps réel</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num">∞</div>
                <div class="auth-stat-label">Simulations Monte Carlo</div>
            </div>
        </div>

    </div>

    <!-- ══ DROITE — FORMULAIRE ══════════════════════════════════════════ -->
    <div class="auth-right">
        <div class="auth-form-wrap">

            <h2 class="auth-form-title">Connexion</h2>
            <p class="auth-form-sub">Entrez vos identifiants pour accéder à votre espace.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                @foreach (var error in ViewData.ModelState[""]?.Errors
                            ?? new Microsoft.AspNetCore.Mvc.ModelBinding.ModelErrorCollection())
                {
                    <div class="mpa-alert mpa-alert-error" style="margin-bottom:16px">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <span>@error.ErrorMessage</span>
                    </div>
                }
            }

            <form asp-controller="Auth" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="field">
                    <label asp-for="Email">Adresse email</label>
                    <input asp-for="Email" type="email"
                           class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")"
                           placeholder="vous@exemple.com"
                           autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Mot de passe</label>
                    <div style="position:relative">
                        <input asp-for="Password" type="password" id="pwd"
                               class="form-control @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                        <button type="button" onclick="togglePwd('pwd','eye1')"
                                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                                       background:none;border:none;cursor:pointer;color:var(--text-300);padding:0">
                            <svg id="eye1" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-black btn-full btn-lg"
                        style="margin-top:8px">
                    Se connecter
                </button>
            </form>

            <div class="auth-form-link">
                Pas encore de compte ?
                <a asp-controller="Auth" asp-action="Register">Créer un compte</a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePwd(inputId, iconId) {
            const el = document.getElementById(inputId);
            const ic = document.getElementById(iconId);
            const isHidden = el.type === 'password';
            el.type = isHidden ? 'text' : 'password';
            ic.innerHTML = isHidden
                ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
                : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
        }
    </script>
}
