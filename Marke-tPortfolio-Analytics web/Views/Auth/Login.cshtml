@model Marke_tPortfolio_Analytics_web.ViewModels.LoginViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Connexion — Catalis";
}

<div class="mpa-auth-body">

    <!-- ── Panneau gauche ─────────────────────────────────── -->
    <div class="auth-left">
        <div>
            <div class="auth-logo">
                <div class="auth-logo-icon"></div>
                <span class="auth-logo-name">Catalis</span>
            </div>
        </div>

        <div>
            <div class="auth-eyebrow">
                <div class="auth-eyebrow-dot"></div>
                Plateforme d'investissement
            </div>

            <h1 class="auth-headline">
                Investissez
                <span class="auth-accent">comme un hedge<br>fund.</span>
                <span class="auth-light">Gratuitement.</span>
            </h1>
            <p class="auth-subline">Stop guessing. Start optimizing.</p>

            <p class="auth-body-copy">
                Analyse quantitative, optimisation Markowitz et Monte Carlo —
                <strong>les outils des professionnels</strong>, enfin accessibles à tous.
            </p>

            <div class="auth-features">
                <div class="auth-feat">
                    <div class="auth-feat-icon">📊</div>
                    <div class="auth-feat-text">
                        <strong>Analytics institutionnels</strong>
                        <span>Sharpe, Alpha, VaR, Max Drawdown en temps réel</span>
                    </div>
                </div>
                <div class="auth-feat">
                    <div class="auth-feat-icon">🎯</div>
                    <div class="auth-feat-text">
                        <strong>Optimisation de portefeuille</strong>
                        <span>Frontière efficiente de Markowitz automatisée</span>
                    </div>
                </div>
                <div class="auth-feat">
                    <div class="auth-feat-icon">🔮</div>
                    <div class="auth-feat-text">
                        <strong>Monte Carlo · 10 000 scénarios</strong>
                        <span>Simulez votre avenir financier sur 1 à 30 ans</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-stats">
            <div class="auth-stat">
                <div class="auth-stat-num green">6+</div>
                <div class="auth-stat-label">Métriques</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num">10K</div>
                <div class="auth-stat-label">Scénarios MC</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num">2</div>
                <div class="auth-stat-label">Devises</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-num green">100%</div>
                <div class="auth-stat-label">Gratuit</div>
            </div>
        </div>

        <!-- Ticker tape -->
        <div class="auth-ticker">
            <div class="ticker-track">
                <span class="tick-item"><span class="tick-sym">AAPL</span><span class="tick-up">▲ 1.24%</span></span>
                <span class="tick-item"><span class="tick-sym">MSFT</span><span class="tick-up">▲ 0.87%</span></span>
                <span class="tick-item"><span class="tick-sym">NVDA</span><span class="tick-up">▲ 3.41%</span></span>
                <span class="tick-item"><span class="tick-sym">OR.PA</span><span class="tick-dn">▼ 0.32%</span></span>
                <span class="tick-item"><span class="tick-sym">TTE.PA</span><span class="tick-up">▲ 0.55%</span></span>
                <span class="tick-item"><span class="tick-sym">S&P 500</span><span class="tick-up">▲ 0.43%</span></span>
                <span class="tick-item"><span class="tick-sym">CAC 40</span><span class="tick-dn">▼ 0.18%</span></span>
                <span class="tick-item"><span class="tick-sym">AMZN</span><span class="tick-up">▲ 1.09%</span></span>
                <span class="tick-item"><span class="tick-sym">AAPL</span><span class="tick-up">▲ 1.24%</span></span>
                <span class="tick-item"><span class="tick-sym">MSFT</span><span class="tick-up">▲ 0.87%</span></span>
                <span class="tick-item"><span class="tick-sym">NVDA</span><span class="tick-up">▲ 3.41%</span></span>
                <span class="tick-item"><span class="tick-sym">OR.PA</span><span class="tick-dn">▼ 0.32%</span></span>
                <span class="tick-item"><span class="tick-sym">TTE.PA</span><span class="tick-up">▲ 0.55%</span></span>
                <span class="tick-item"><span class="tick-sym">S&P 500</span><span class="tick-up">▲ 0.43%</span></span>
                <span class="tick-item"><span class="tick-sym">CAC 40</span><span class="tick-dn">▼ 0.18%</span></span>
                <span class="tick-item"><span class="tick-sym">AMZN</span><span class="tick-up">▲ 1.09%</span></span>
            </div>
        </div>
    </div>

    <!-- ── Panneau droit ──────────────────────────────────── -->
    <div class="auth-right">
        <div class="auth-form-wrap">

            <!-- Tabs -->
            <div class="auth-tabs">
                <a href="/Auth/Login" class="auth-tab active">Connexion</a>
                <a href="/Auth/Register" class="auth-tab">Inscription</a>
            </div>

            <h2 class="auth-form-title">Bon retour 👋</h2>
            <p class="auth-form-sub">Connectez-vous pour accéder à votre portefeuille.</p>

            <!-- Alerts -->
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="mpa-alert mpa-alert-error" id="alert-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    @ViewBag.Error
                    <button class="alert-close" onclick="this.closest('.mpa-alert').remove()">✕</button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="mpa-alert mpa-alert-success" id="alert-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20,6 9,17 4,12" /></svg>
                    @TempData["Success"]
                    <button class="alert-close" onclick="this.closest('.mpa-alert').remove()">✕</button>
                </div>
            }

            <form asp-action="Login" asp-controller="Auth" method="post" id="loginForm">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="field">
                    <label asp-for="Email">Adresse e-mail</label>
                    <div style="position:relative">
                        <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);opacity:.4;pointer-events:none"
                             width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                        </svg>
                        <input asp-for="Email" class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               type="email" placeholder="jean.dupont@email.com"
                               style="padding-left:42px" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <!-- Mot de passe -->
                <div class="field">
                    <label asp-for="Password">Mot de passe</label>
                    <div style="position:relative">
                        <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);opacity:.4;pointer-events:none"
                             width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <input asp-for="Password" id="passwordInput"
                               class="form-control @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               type="password" placeholder="••••••••"
                               style="padding-left:42px;padding-right:46px" autocomplete="current-password" />
                        <button type="button" id="togglePwd"
                                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#475569;padding:4px;transition:color .15s"
                                onmouseover="this.style.color='#94a3b8'" onmouseout="this.style.color='#475569'">
                            <svg id="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <!-- Forgot -->
                <div class="auth-link-row">
                    <a href="#" class="auth-link">Mot de passe oublié ?</a>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-auth-submit" id="submitBtn">
                    <span id="submitText">Accéder à mon portefeuille</span>
                    <span class="btn-auth-arrow">→</span>
                    <svg id="submitSpinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:none;animation:spin .7s linear infinite">
                        <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                    </svg>
                </button>
                @keyframes spin { to { transform: rotate(360deg); } }

            </form>

            <!-- Demo -->
            <div class="auth-divider">
                <div class="auth-divider-line"></div>
                <span class="auth-divider-text">ou</span>
                <div class="auth-divider-line"></div>
            </div>
            <button type="button" class="btn-demo" id="demoBtn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5,3 19,12 5,21 5,3" /></svg>
                Explorer avec le compte démo
            </button>

            <p class="auth-switch">
                Pas encore de compte ? <a href="/Auth/Register">Créer un compte →</a>
            </p>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Toggle password visibility
        document.getElementById('togglePwd').addEventListener('click', function () {
          const input = document.getElementById('passwordInput');
          input.type = input.type === 'password' ? 'text' : 'password';
          this.style.opacity = input.type === 'text' ? '1' : '.6';
        });

        // Submit spinner
        document.getElementById('loginForm').addEventListener('submit', function () {
          const btn = document.getElementById('submitBtn');
          document.getElementById('submitText').textContent = 'Connexion…';
          document.getElementById('submitSpinner').style.display = 'inline';
          document.querySelector('.btn-auth-arrow').style.display = 'none';
          btn.disabled = true;
        });

        // Demo account
        document.getElementById('demoBtn').addEventListener('click', function () {
          document.querySelector('input[name="Email"]').value = 'demo@catalis.io';
          document.querySelector('input[name="Password"]').value = 'Demo1234!';
          document.getElementById('loginForm').requestSubmit();
        });
    </script>
}
