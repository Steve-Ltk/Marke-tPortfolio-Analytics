@model Marke_tPortfolio_Analytics_web.ViewModels.AssetIndexViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Marché";
    ViewData["Section"] = "Marché";
}

<div class="page-header">
    <div>
        <div class="page-title">Marché</div>
        <div class="page-sub">
            @Model.Assets.Count actif(s) ·
            <span style="color:var(--blue)">@Model.NbStocks actions</span> ·
            <span style="color:var(--purple)">@Model.NbBonds obligations</span> ·
            Taux EUR/USD : <strong>@Model.TauxEurUsd.ToString("F4")</strong>
        </div>
    </div>
    <div class="header-actions">
        <button class="btn btn-ghost" onclick="document.getElementById('importPanel').classList.toggle('hidden')" style="gap:6px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" y1="3" x2="12" y2="15" />
            </svg>
            Importer via FMP
        </button>
    </div>
</div>

<!-- Panel import FMP -->
<div id="importPanel" class="hidden" style="margin-bottom:20px">
    <div class="card" style="max-width:480px">
        <div class="card-title" style="margin-bottom:14px">Importer un actif depuis FMP</div>
        <form asp-action="ImportFmp" asp-controller="Assets" method="post" style="display:flex;gap:10px;flex-wrap:wrap">
            @Html.AntiForgeryToken()
            <input type="text" name="ticker" placeholder="Ex : AAPL, MC.PA, TLT…"
                   class="form-control" style="flex:1" autocomplete="off" />
            <select name="assetType" class="form-control" style="width:140px">
                <option value="stock">Action</option>
                <option value="bond">Obligation</option>
            </select>
            <button type="submit" class="btn btn-green" style="white-space:nowrap">Importer →</button>
        </form>
        <div style="font-size:11.5px;color:var(--t4);margin-top:8px">
            Entrez le ticker exact (NASDAQ, NYSE ou Euronext). Exemple : AAPL, MSFT, MC.PA, TTE.PA, TLT
        </div>
    </div>
</div>

<!-- Barre de filtres + recherche -->
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap">
    <form method="get" style="display:flex;align-items:center;gap:10px;flex:1;min-width:280px">
        <div class="topbar-search" style="flex:1;max-width:400px;height:40px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
            </svg>
            <input name="q" value="@Model.Recherche" placeholder="Rechercher AAPL, MSFT, L'Oréal…" autocomplete="off" />
        </div>
        <input type="hidden" name="type" value="@Model.FiltreType" />
        <button type="submit" class="btn btn-ghost" style="height:40px">Chercher</button>
    </form>

    <div style="display:flex;gap:6px">
        @foreach (var f in new[] { "Tous", "Stock", "Bond" })
        {
            <a href="?type=@f&q=@Model.Recherche"
               class="btn @(Model.FiltreType == f ? "btn-green" : "btn-ghost")"
               style="height:36px;font-size:12px">@f</a>
        }
    </div>
</div>

@if (!Model.AssetsFiltrés.Any())
{
    <div style="text-align:center;padding:60px 0;color:var(--t4)">
        <div style="font-size:40px;margin-bottom:16px">🔍</div>
        <div style="font-size:16px;font-weight:600;margin-bottom:8px">Aucun actif trouvé</div>
        <div style="font-size:13px">Essayez un autre terme ou importez un actif via FMP.</div>
    </div>
}
else
{
    <!-- ══ HEATMAP ══ -->
    <div style="margin-bottom:28px">
        <div style="font-size:12px;font-weight:600;color:var(--t4);letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px">
            Heatmap — @Model.AssetsFiltrés.Count actif(s)
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px">
            @foreach (var a in Model.AssetsFiltrés)
            {
                <a href="/Assets/Details/@a.Id"
                   style="background:@a.HeatmapBg;border:1px solid @a.HeatmapBorder;border-radius:12px;padding:14px 12px;text-decoration:none;display:block;transition:transform .15s"
                   onmouseover="this.style.transform='translateY(-2px)'"
                   onmouseout="this.style.transform='translateY(0)'">
                    <div style="font-family:Sora,sans-serif;font-weight:800;font-size:14px;color:var(--t1);margin-bottom:3px">@a.Ticker</div>
                    <div style="font-size:10px;color:var(--t4);margin-bottom:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@a.Nom</div>
                    <div style="font-family:Sora,sans-serif;font-weight:700;font-size:15px;color:var(--t1)">
                        @a.DeviseNative @a.PrixNatif.ToString("N2")
                    </div>
                    <div style="font-size:11px;color:var(--t4)">€@a.PrixEur.ToString("N2")</div>
                    @if (a.VariationJour != 0)
                    {
                        <div style="font-size:12px;font-weight:700;color:@a.VariationCouleur;margin-top:4px">
                            @a.VariationSigne @Math.Abs(a.VariationJour).ToString("F2")%
                        </div>
                    }
                </a>
            }
        </div>
    </div>

    <!-- ══ TABLE ══ -->
    <div class="card">
        <div class="card-header">
            <div><div class="card-title">Tous les actifs</div><div class="card-sub">Prix via FMP · Dual-devise EUR / USD</div></div>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Actif</th>
                        <th>Type</th>
                        <th>Marché</th>
                        <th>Prix natif</th>
                        <th>Prix EUR</th>
                        <th>Prix USD</th>
                        <th>Variation</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.AssetsFiltrés)
                    {
                        <tr>
                            <td>
                                <div class="td-ticker">@a.Ticker</div>
                                <div class="td-name">@a.Nom</div>
                            </td>
                            <td>
                                <span class="badge @(a.TypeLabel == "Bond" ? "badge-purple" : "badge-blue")">
                                    @a.TypeLabel
                                </span>
                            </td>
                            <td style="font-size:12px;color:var(--t4)">@(string.IsNullOrEmpty(a.Exchange) ? "—" : a.Exchange)</td>
                            <td style="font-weight:600">@a.DeviseNative @a.PrixNatif.ToString("N2")</td>
                            <td>€@a.PrixEur.ToString("N2")</td>
                            <td>$@a.PrixUsd.ToString("N2")</td>
                            <td>
                                @if (a.VariationJour != 0)
                                {
                                    <span style="font-weight:600;color:@a.VariationCouleur">
                                        @a.VariationSigne @Math.Abs(a.VariationJour).ToString("F2")%
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--t4)">—</span>
                                }
                            </td>
                            <td>
                                <a href="/Assets/Details/@a.Id" class="btn btn-ghost btn-sm">Détail →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .hidden {
        display: none !important;
    }
</style>
