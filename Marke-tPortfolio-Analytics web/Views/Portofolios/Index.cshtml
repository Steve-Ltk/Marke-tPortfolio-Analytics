@model Marke_tPortfolio_Analytics_web.ViewModels.PortfolioIndexViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mes Portefeuilles";
    ViewData["Section"] = "Portefeuilles";
}

<div class="page-header">
    <div>
        <div class="page-title">Mes Portefeuilles</div>
        <div class="page-sub">
            @Model.Portfolios.Count portefeuille(s) ·
            Valeur totale :
            <strong style="color:var(--green)">€@Model.ValeurTotaleEur.ToString("N2")</strong>
        </div>
    </div>
    <a href="/Portfolios/Create" class="btn btn-green">+ Nouveau portefeuille</a>
</div>

@if (!Model.HasPortfolios)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;
                    min-height:360px;text-align:center;gap:24px">
        <div style="width:80px;height:80px;background:var(--green-faint);
                        border:1px solid rgba(0,208,132,.2);border-radius:50%;
                        display:flex;align-items:center;justify-content:center;font-size:32px">
            💼
        </div>
        <div>
            <div style="font-family:Sora,sans-serif;font-size:22px;font-weight:700;margin-bottom:8px">
                Aucun portefeuille
            </div>
            <div style="color:var(--t4);font-size:14px;max-width:400px">
                Créez votre premier portefeuille et ajoutez des actifs pour commencer.
            </div>
        </div>
        <a href="/Portfolios/Create" class="btn btn-green btn-lg">
            + Créer mon premier portefeuille →
        </a>
    </div>
    return;
}

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px">
    @foreach (var card in Model.Portfolios.OrderByDescending(c => c.ValeurEur))
    {
        var p = card.Portfolio;
        var signe = card.RendementPct >= 0 ? "+" : "";
        var rColor = card.RendementPct >= 0 ? "var(--green)" : "var(--red)";

        <div class="card" style="display:flex;flex-direction:column;gap:0">
            <!-- En-tête -->
            <div style="display:flex;align-items:flex-start;justify-content:space-between;
                            margin-bottom:16px">
                <div>
                    <div style="font-family:Sora,sans-serif;font-weight:700;font-size:16px;
                                    margin-bottom:3px">
                        @p.Name
                    </div>
                    <div style="font-size:12px;color:var(--t4)">
                        @p.Currency · @card.NbPositions position(s)
                    </div>
                    {{-- ✅ Portfolio n'a PAS de Description — retiré --}}
                </div>
                <div style="display:flex;gap:6px">
                    <a href="/Portfolios/Edit/@p.Id" class="btn btn-ghost btn-sm">✏️</a>
                    <form asp-action="Delete" asp-controller="Portfolios" method="post"
                          style="margin:0"
                          onsubmit="return confirm('Supprimer le portefeuille « @p.Name » ?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">🗑</button>
                    </form>
                </div>
            </div>

            <!-- Valeur + rendement -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px">
                <div style="background:var(--dark-4);border-radius:10px;padding:14px">
                    <div style="font-size:10px;color:var(--t4);margin-bottom:3px">Valeur actuelle</div>
                    <div style="font-family:Sora,sans-serif;font-weight:800;font-size:18px;
                                    color:var(--green)">
                        €@card.ValeurEur.ToString("N2")
                    </div>
                </div>
                <div style="background:var(--dark-4);border-radius:10px;padding:14px">
                    <div style="font-size:10px;color:var(--t4);margin-bottom:3px">Rendement</div>
                    <div style="font-family:Sora,sans-serif;font-weight:800;font-size:18px;
                                    color:@rColor">
                        @signe@card.RendementPct.ToString("F1")%
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div style="display:flex;gap:8px;margin-top:auto">
                <a href="/Portfolios/Details/@p.Id"
                   class="btn btn-green" style="flex:1;text-align:center">
                    Voir les positions →
                </a>
                <a href="/Analytics?portfolioId=@p.Id" class="btn btn-ghost" style="width:44px;text-align:center">
                    📊
                </a>
            </div>
        </div>
    }
</div>
