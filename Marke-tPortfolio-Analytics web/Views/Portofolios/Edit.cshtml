@model Marke_tPortfolio_Analytics_web.ViewModels.PortfolioEditViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Modifier — " + Model.Name;
    ViewData["Section"] = "Portefeuilles";
}

<div class="page-header">
    <div>
        <div class="page-title">Modifier le portefeuille</div>
        <div class="page-sub">@Model.Name</div>
    </div>
    <a href="/Portfolios/Details/@Model.Id" class="btn btn-ghost">← Annuler</a>
</div>

<div style="max-width:520px">
    <div class="card">
        <form asp-action="Edit" asp-controller="Portfolios" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="field">
                <label asp-for="Name">Nom du portefeuille</label>
                <input asp-for="Name" class="form-control @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "is-invalid" : "")"
                       placeholder="Nom…" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="field">
                <label asp-for="Currency">Devise de référence</label>
                <select asp-for="Currency" class="form-control">
                    <option value="EUR">EUR — Euro</option>
                    <option value="USD">USD — Dollar américain</option>
                </select>
            </div>

            <button type="submit" class="btn btn-green btn-full btn-lg">
                Enregistrer les modifications
            </button>
        </form>
    </div>
</div>
