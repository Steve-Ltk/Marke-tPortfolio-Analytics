@model Marke_tPortfolio_Analytics_web.ViewModels.PositionEditViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Modifier — " + Model.AssetTicker;
    ViewData["Section"] = "Portefeuilles";
}

<div class="page-header">
    <div>
        <div class="page-title">Modifier la position</div>
        <div class="page-sub">
            <strong>@Model.AssetTicker</strong> — @Model.AssetNom ·
            Portefeuille : @Model.PortfolioName
        </div>
    </div>
    <a href="/Portfolios/Details/@Model.PortfolioId" class="btn btn-ghost">← Annuler</a>
</div>

<div style="max-width:520px">
    <div class="card">
        <!-- Actif non modifiable -->
        <div class="field">
            <label>Actif</label>
            <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--dark-4);border:1px solid var(--border);border-radius:var(--radius-md)">
                <span style="font-family:Sora,sans-serif;font-weight:700;font-size:15px">@Model.AssetTicker</span>
                <span style="color:var(--t4);font-size:13px">@Model.AssetNom</span>
                <span class="badge badge-blue" style="margin-left:auto">Non modifiable</span>
            </div>
        </div>

        <form asp-action="Edit" asp-controller="Positions" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PortfolioId" />

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                <div class="field">
                    <label asp-for="Quantity">Quantité</label>
                    <input asp-for="Quantity" type="number" step="0.0001" min="0.0001"
                           class="form-control @(ViewData.ModelState["Quantity"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                    <span asp-validation-for="Quantity" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="PurchasePrice">Prix d'achat moyen</label>
                    <input asp-for="PurchasePrice" type="number" step="0.01" min="0.01"
                           class="form-control @(ViewData.ModelState["PurchasePrice"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                    <span asp-validation-for="PurchasePrice" class="field-error"></span>
                </div>
            </div>

            <div class="field">
                <label asp-for="PurchaseDate">Date d'achat</label>
                <input asp-for="PurchaseDate" type="date"
                       class="form-control @(ViewData.ModelState["PurchaseDate"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                <span asp-validation-for="PurchaseDate" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-green btn-full btn-lg">
                Enregistrer les modifications
            </button>
        </form>
    </div>
</div>
