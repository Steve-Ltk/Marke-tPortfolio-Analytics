@model Marke_tPortfolio_Analytics_web.ViewModels.PositionCreateViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ajouter une position";
    ViewData["Section"] = "Portefeuilles";
}

<div class="page-header">
    <div>
        <div class="page-title">Ajouter une position</div>
        <div class="page-sub">Portefeuille : <strong>@Model.PortfolioName</strong></div>
    </div>
    <a href="/Portfolios/Details/@Model.PortfolioId" class="btn btn-ghost">← Annuler</a>
</div>

<div style="max-width:560px">
    <div class="card">
        <form asp-action="Create" asp-controller="Positions" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PortfolioId" />

            <div class="field">
                <label asp-for="AssetId">Actif</label>
                <select asp-for="AssetId"
                        class="form-control @(ViewData.ModelState["AssetId"]?.Errors.Count > 0 ? "is-invalid" : "")">
                    <option value="">— Sélectionner un actif —</option>
                    @foreach (var g in Model.Assets.GroupBy(a => a.Type))
                    {
                        <optgroup label="@g.Key">
                            @foreach (var a in g.OrderBy(x => x.Ticker))
                            {
                                <option value="@a.Id">@a.Ticker — @a.Nom</option>
                            }
                        </optgroup>
                    }
                </select>
                <span asp-validation-for="AssetId" class="field-error"></span>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                <div class="field">
                    <label asp-for="Quantity">Quantité</label>
                    <input asp-for="Quantity" type="number" step="0.0001" min="0.0001"
                           class="form-control @(ViewData.ModelState["Quantity"]?.Errors.Count > 0 ? "is-invalid" : "")"
                           placeholder="Ex : 10" />
                    <span asp-validation-for="Quantity" class="field-error"></span>
                </div>
                <div class="field">
                    {{!-- ✅ asp-for="AvgBuyPrice" correspond à Position.AvgBuyPrice --}}
                    <label asp-for="AvgBuyPrice">Prix d'achat moyen</label>
                    <input asp-for="AvgBuyPrice" type="number" step="0.01" min="0.01"
                           class="form-control @(ViewData.ModelState["AvgBuyPrice"]?.Errors.Count > 0 ? "is-invalid" : "")"
                           placeholder="Ex : 180.50" />
                    <span asp-validation-for="AvgBuyPrice" class="field-error"></span>
                </div>
            </div>

            <div class="field">
                {{!-- ✅ asp-for="BuyDate" correspond à Position.BuyDate --}}
                <label asp-for="BuyDate">Date d'achat</label>
                <input asp-for="BuyDate" type="date"
                       class="form-control @(ViewData.ModelState["BuyDate"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                <span asp-validation-for="BuyDate" class="field-error"></span>
            </div>

            <div class="insight-box" style="margin-bottom:18px">
                <strong>ℹ️ Note</strong><br>
                Le prix actuel sera récupéré en temps réel via FMP.
                Un actif ne peut apparaître qu'<strong>une seule fois</strong> par portefeuille.
            </div>

            <button type="submit" class="btn btn-green btn-full btn-lg">
                Ajouter la position →
            </button>
        </form>
    </div>
</div>
