@model Marke_tPortfolio_Analytics_web.ViewModels.PortfolioCreateViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nouveau portefeuille";
    ViewData["Section"] = "Portefeuilles";
}

<div class="page-header">
    <div>
        <div class="page-title">Nouveau portefeuille</div>
        <div class="page-sub">Définissez le nom et la devise de référence.</div>
    </div>
    <a href="/Portfolios" class="btn btn-ghost">← Annuler</a>
</div>

<div style="max-width:520px">
    <div class="card">
        <form asp-action="Create" asp-controller="Portfolios" method="post">
            @Html.AntiForgeryToken()

            <div class="field">
                <label asp-for="Name">Nom du portefeuille</label>
                <input asp-for="Name"
                       class="form-control @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "is-invalid" : "")"
                       placeholder="Ex : Tech Growth, Retraite 2040…"
                       autocomplete="off" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Currency">Devise de référence</label>
                <select asp-for="Currency" class="form-control">
                    <option value="EUR">EUR — Euro</option>
                </select>
            </div>

            <div class="insight-box" style="margin-bottom:18px">
                <strong>ℹ️ Note</strong><br>
                La devise de référence sert à l'affichage. Les actifs peuvent être cotés
                dans d'autres devises — la conversion EUR/USD est automatique via FMP.
            </div>

            <button type="submit" class="btn btn-green btn-full btn-lg">
                Créer le portefeuille →
            </button>
        </form>
    </div>
</div>
