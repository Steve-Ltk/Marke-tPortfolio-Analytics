{
  // ── Journalisation ──────────────────────────────────────────────────────────
  // Contrôle le niveau de détail des logs dans la console.
  //
  // Niveaux disponibles (du moins au plus verbeux) :
  //   Trace → Debug → Information → Warning → Error → Critical
  //
  // "Default": "Information" → affiche les requêtes HTTP, les démarrages, etc.
  // "Microsoft.AspNetCore": "Warning" → masque les logs internes d'ASP.NET (trop verbeux)
  // "Microsoft.EntityFrameworkCore": "Warning" → masque les requêtes SQL générées par EF
  //
  // En développement, passez "Microsoft.EntityFrameworkCore" à "Information"
  // pour voir les requêtes SQL dans la console (utile pour déboguer).

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  // ── Chaîne de connexion SQL Server ─────────────────────────────────────────
  // Le nom "MarketPortfolioAnalyticsContext" doit correspondre exactement
  // à ce qu'on lit dans Program.cs :
  //   builder.Configuration.GetConnectionString("MarketPortfolioAnalyticsContext")
  //
  // Paramètres importants :
  //   Server   → nom du serveur SQL (ici l'instance locale par défaut)
  //   Database → nom de la base de données (créée automatiquement par EnsureCreated)
  //   Trusted_Connection=True → authentification Windows (pas de login/mot de passe)
  //   TrustServerCertificate=True → nécessaire en développement local avec SQL Server Express
  //
  // Pour SQL Server avec login/mot de passe, remplacez par :
  //   "Server=monserveur;Database=MarketPortfolioAnalytics;User Id=monlogin;Password=monmdp;TrustServerCertificate=True"

  "ConnectionStrings": {
    "MarketPortfolioAnalyticsContext": "Server=(localdb)\\mssqllocaldb;Database=MarketPortfolioAnalytics;Trusted_Connection=True;TrustServerCertificate=True"
  },

  // ── Configuration FMP (Financial Modeling Prep) ─────────────────────────────
  // Lue dans Program.cs via : builder.Services.Configure<FmpOptions>(...)
  // Injectée dans FmpService via : IOptions<FmpOptions>
  //
  // BaseUrl : URL de base de l'API FMP — ne change jamais
  // ApiKey  : votre clé personnelle FMP
  //           → Obtenez-la sur https://financialmodelingprep.com/developer/docs
  //           → Plan gratuit : 250 requêtes/jour, historique limité à 5 ans
  //
  // ⚠️ En production : ne jamais mettre la clé API dans ce fichier
  //    Utilisez plutôt les secrets utilisateur (dotnet user-secrets)
  //    ou les variables d'environnement :
  //      Fmp__ApiKey=votre_clé

  "Fmp": {
    "BaseUrl": "https://financialmodelingprep.com",
    "ApiKey": "Ehqbk10Lzyo3vu8MsXtynpS6lKcs47Ae"
  },

  // ── URLs d'écoute ──────────────────────────────────────────────────────────
  // Ports sur lesquels l'API écoute en développement.
  // HTTP  : http://localhost:5154
  // HTTPS : https://localhost:7154  (nécessite le certificat de développement ASP.NET)
  //
  // Pour installer le certificat si ce n'est pas fait :
  //   dotnet dev-certs https --trust

  "AllowedHosts": "*"
}
